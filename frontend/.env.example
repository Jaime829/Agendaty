# Agendaty Frontend - variables de entorno
# Copiar este archivo a .env y completar los valores

# URL del backend API
VITE_API_URL=http://localhost:8080

# Modo mock: "true" para usar datos simulados sin backend, "false" para usar backend real
VITE_USE_MOCK=true

# Tiempo de polling del monitor del coordinador (ms)
VITE_POLL_INTERVAL_MS=5000

# Título de la aplicación
VITE_APP_TITLE=Agendaty - Atención al Ciudadano